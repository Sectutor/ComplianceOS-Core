# Enterprise Scalability Configuration
# This file contains the environment variables needed for enterprise-scale deployment

# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database
DATABASE_READ_URL=postgresql://username:password@read-replica-host:port/database

# Redis Configuration (Required for caching and session management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_CLUSTER=false
REDIS_SENTINEL=false

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_ALERTING_ENABLED=true
METRICS_COLLECTION_INTERVAL=30000

# Database Pool Configuration
DB_MAX_CONNECTIONS=100
DB_IDLE_TIMEOUT=30
DB_STATEMENT_TIMEOUT=10000
DB_CONNECTION_TIMEOUT=30

# Cache Configuration
CACHE_TTL_DASHBOARD=300
CACHE_TTL_API_RESPONSE=60
CACHE_TTL_USER_SESSION=1800
CACHE_MAX_MEMORY_ENTRIES=1000

# Load Balancing and Scaling
ENABLE_HORIZONTAL_SCALING=false
LOAD_BALANCER_STICKY_SESSIONS=true
AUTO_SCALING_ENABLED=false
MIN_INSTANCES=1
MAX_INSTANCES=5

# File Storage (S3 Configuration for scalable file storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=compliance-os-files
S3_ENDPOINT=https://s3.amazonaws.com

# Monitoring and Alerting
PROMETHEUS_METRICS_ENABLED=true
GRAFANA_DASHBOARD_ENABLED=false
ALERT_WEBHOOK_URL=https://hooks.slack.com/your-webhook

# Rate Limiting
RATE_LIMITING_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_BURST_SIZE=150

# Security
ENABLE_SECURITY_HEADERS=true
DDOS_PROTECTION_ENABLED=false
WAF_ENABLED=false

# Development/Testing
NODE_ENV=development
LOG_LEVEL=info
DEBUG_PERFORMANCE=false
SIMULATE_HIGH_LOAD=false